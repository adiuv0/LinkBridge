@@ -17,7 +17,7 @@ export interface ILink {
 	LINKRECTORI: string;
 	/** Protocol. Usually RATTA_RLE. */
 	LINKPROTOCAL: string;
-	/** Base64-encoded absolute path to the linked .note file on the device. */
+	/** Base64-encoded target: an absolute device path or external URL. */
 	LINKFILE: string;
