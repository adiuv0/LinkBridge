index 88d513e..e774f8c 100644
--- a/src/parsing.ts
+++ b/src/parsing.ts
@@ -693,20 +693,23 @@ export class SupernoteX implements ISupernote {
 			parseInt((data.LINKBITMAP as string) ?? '0'),
 			this.lengthFieldSize,
 		);
-		// LINKFILE is a base64-encoded absolute path on the device, e.g.:
-		// /storage/emulated/0/Note/Folder/MyNote.note
-		let text = '';
+		// LINKFILE is base64-encoded. Internal links contain an absolute path
+		// on the device; URL links contain the exact external URL.
+		let target = '';
 		if (data.LINKFILE) {
 			try {
-				const path = atob(data.LINKFILE as string);
-				text = path.split('/').pop()?.replace(/\.note$/i, '') ?? '';
+				target = atob(data.LINKFILE as string);
 			} catch {
 				// ignore malformed base64
 			}
 		}
+		const isExternal = /^https?:\/\//i.test(target);
+		let text = isExternal
+			? target
+			: target.split('/').pop()?.replace(/\.note$/i, '') ?? '';
 		// Append #PageN when the target page exists in this document.
 		const pageid = data.PAGEID as string | undefined;
-		if (pageid && pageid !== '0' && pageid !== 'none') {
+		if (!isExternal && pageid && pageid !== '0' && pageid !== 'none') {
