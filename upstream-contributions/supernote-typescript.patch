 	OBJPAGE: string;
-	/** Decoded filename (without path or .note extension) ready for use as [[link]]. */
+	/** Decoded display target: note basename/anchor for internal links, exact URL for external links. */
 	text: string;
+	/** Exact decoded LINKFILE target before internal-note basename normalization. */
+	target: string;
